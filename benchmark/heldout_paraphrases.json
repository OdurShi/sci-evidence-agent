{
  "name": "sci-evidence-bench-heldout",
  "version": "1.0",
  "written_on": "2026-11-14",
  "description": "20 differently phrased questions, written once before the offline planner was scored on them and never used to adjust its rules. They are scored on planning only (no network), at two levels: (1) the planned tool rounds equal expected_tools; (2) in addition, every call listed in expected_arguments is planned with exactly those argument values (the entity a competent agent would look up). expected_arguments was added after the first scoring, when it turned out that level 1 alone accepts a correct tool with a wrong query; it can only lower the score. Because the keyword planner and the main benchmark were written together, this set is the only out-of-sample indication of how the planner copes with free phrasing.",
  "questions": [
    {"id": "H01", "category": "compound", "question": "I need the SMILES string for ibuprofen.", "expected_tools": [["search_compound"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "ibuprofen"}}]},
    {"id": "H02", "category": "compound", "question": "Can you tell me how much caffeine weighs (molecular weight)?", "expected_tools": [["search_compound"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "caffeine"}}]},
    {"id": "H03", "category": "compound", "question": "PubChem entry for vitamin C please", "expected_tools": [["search_compound"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "vitamin C"}}]},
    {"id": "H04", "category": "compound", "question": "Molecular formula for CID 3672?", "expected_tools": [["search_compound"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "3672"}}]},
    {"id": "H05", "category": "compound", "question": "阿司匹林的分子式是什么？", "expected_tools": [["search_compound"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "aspirin"}}]},
    {"id": "H06", "category": "bioactivity_chain", "question": "How potent is imatinib? Show its IC50 measurements from ChEMBL.", "expected_tools": [["search_chembl_molecule"], ["get_bioactivities"]], "expected_arguments": [{"tool": "search_chembl_molecule", "arguments": {"query": "imatinib"}}]},
    {"id": "H07", "category": "bioactivity_chain", "question": "Assay results for CHEMBL521", "expected_tools": [["get_bioactivities"]], "expected_arguments": [{"tool": "get_bioactivities", "arguments": {"chembl_id": "CHEMBL521"}}]},
    {"id": "H08", "category": "bioactivity_chain", "question": "What does ChEMBL know about the activity of metformin against its targets?", "expected_tools": [["search_chembl_molecule"], ["get_bioactivities"]], "expected_arguments": [{"tool": "search_chembl_molecule", "arguments": {"query": "metformin"}}]},
    {"id": "H09", "category": "protein", "question": "Which protein does the human gene BRCA1 encode? Give the UniProt accession.", "expected_tools": [["search_protein"]], "expected_arguments": [{"tool": "search_protein", "arguments": {"query": "gene:BRCA1", "organism_id": 9606}}]},
    {"id": "H10", "category": "protein", "question": "UniProt record for rat insulin", "expected_tools": [["search_protein"]], "expected_arguments": [{"tool": "search_protein", "arguments": {"query": "insulin", "organism_id": 10116}}]},
    {"id": "H11", "category": "protein", "question": "Tell me about UniProt entry Q9BYF1.", "expected_tools": [["search_protein"]], "expected_arguments": [{"tool": "search_protein", "arguments": {"query": "Q9BYF1"}}]},
    {"id": "H12", "category": "literature", "question": "Recent papers on CRISPR base editing", "expected_tools": [["search_literature"]], "expected_arguments": [{"tool": "search_literature", "arguments": {"term": "CRISPR base editing"}}]},
    {"id": "H13", "category": "literature", "question": "Pull up PubMed ID 21376230.", "expected_tools": [["get_article"]], "expected_arguments": [{"tool": "get_article", "arguments": {"pmid": "21376230"}}]},
    {"id": "H14", "category": "literature", "question": "Any publications linking metformin to longevity?", "expected_tools": [["search_literature"]], "expected_arguments": [{"tool": "search_literature", "arguments": {"term": "metformin AND longevity"}}]},
    {"id": "H15", "category": "literature", "question": "Get the DOI for the article with PMID 5284360", "expected_tools": [["get_article"]], "expected_arguments": [{"tool": "get_article", "arguments": {"pmid": "5284360"}}]},
    {"id": "H16", "category": "cross_source", "question": "What compounds are found in Panax ginseng?", "expected_tools": [["search_by_taxon"]], "expected_arguments": [{"tool": "search_by_taxon", "arguments": {"taxon": "Panax ginseng"}}]},
    {"id": "H17", "category": "cross_source", "question": "Is quercetin a natural product? Which organisms produce it?", "expected_tools": [["search_compound"], ["search_occurrences"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "quercetin"}}]},
    {"id": "H18", "category": "cross_source", "question": "Compare what PubChem and ChEMBL have on sildenafil, including bioassay activities.", "expected_tools": [["search_compound", "search_chembl_molecule"], ["get_bioactivities"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "sildenafil"}}, {"tool": "search_chembl_molecule", "arguments": {"query": "sildenafil"}}]},
    {"id": "H19", "category": "cross_source", "question": "Find the protein entry for PTGS2 in human and some literature about celecoxib.", "expected_tools": [["search_protein", "search_literature"]], "expected_arguments": [{"tool": "search_protein", "arguments": {"query": "gene:PTGS2", "organism_id": 9606}}, {"tool": "search_literature", "arguments": {"term": "celecoxib"}}]},
    {"id": "H20", "category": "cross_source", "question": "Bioactivity of paracetamol in ChEMBL and its PubChem identifiers", "expected_tools": [["search_compound", "search_chembl_molecule"], ["get_bioactivities"]], "expected_arguments": [{"tool": "search_compound", "arguments": {"query": "paracetamol"}}, {"tool": "search_chembl_molecule", "arguments": {"query": "paracetamol"}}]}
  ]
}
