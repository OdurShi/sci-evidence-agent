# Copy to .env and fill in what you need. Every value may stay empty:
# without any key the offline keyword planner is used.

# Planner: anthropic | openai | offline.
# Empty: anthropic when ANTHROPIC_API_KEY is set, otherwise offline.
LLM_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI-compatible endpoint (OpenAI, DeepSeek, Qwen, vLLM, Ollama, ...)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=

# NCBI E-utilities (optional): a key raises the PubMed limit from 3 to 10 requests/second
NCBI_API_KEY=
NCBI_EMAIL=

# Storage and politeness (optional)
SCI_EVIDENCE_DATA_DIR=
SCI_EVIDENCE_CACHE_TTL_HOURS=
SCI_EVIDENCE_USER_AGENT=
SCI_EVIDENCE_WDQS_INTERVAL=
